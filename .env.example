DATABASE_URL=postgresql://platform:platform@localhost:5433/platform?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# Development/test only. Set true explicitly to expose the local mock model.
MOCK_PROVIDER_ENABLED=false
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
GUEST_DAILY_MESSAGE_LIMIT=12
MAX_OUTPUT_TOKENS=1200
PROVIDER_TIMEOUT_MS=60000
AUTO_ROUTING_POLICY_VERSION=auto-v1
AUTO_MODEL_PREFERENCE=openai:gpt-4.1-mini,openai:gpt-4.1,gemini:gemini-3.8-flash
AUTO_MAX_FALLBACK_ATTEMPTS=2
SUMMARY_MODEL_ID=openai:gpt-4.1-mini
SUMMARY_MAX_OUTPUT_TOKENS=1200
SUMMARY_TRIGGER_RATIO=0.72
SUMMARY_RECENT_TURNS=4
SUMMARY_JOB_LEASE_SECONDS=90
SUMMARY_WORKER_POLL_MS=1000
USAGE_OUTBOX_POLL_MS=1000
MEMORY_SUGGESTION_MIN_CONFIDENCE=0.75
MEMORY_SUGGESTION_MIN_USEFULNESS=0.70
MEMORY_SUGGESTION_MAX_PER_HOUR=3
MEMORY_SUGGESTION_TTL_HOURS=168
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_MAX_TOKENS=500
MEMORY_MAX_PER_MEMORY_TOKENS=128
MEMORY_RETRIEVAL_MIN_RANK=0.04
MEMORY_EXPIRY_POLL_MS=60000
# Optional price overrides (USD per million tokens); estimates use this table.
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60
OPENAI_INPUT_USD_PER_MILLION_GPT_41=2.00
OPENAI_OUTPUT_USD_PER_MILLION_GPT_41=8.00
OPENAI_PRICING_CURRENCY=USD
OPENAI_PRICING_VERSION=openai-config-v1
# For another currency, set all four generic model rates (not the USD-named rates).
# OPENAI_INPUT_PRICE_PER_MILLION=...
# OPENAI_OUTPUT_PRICE_PER_MILLION=...
# OPENAI_GPT_41_INPUT_PRICE_PER_MILLION=...
# OPENAI_GPT_41_OUTPUT_PRICE_PER_MILLION=...
# Gemini 3.8 Flash introductory rates through 2026-12-31 (USD per million).
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
GEMINI_PRICING_CURRENCY=USD
GEMINI_PRICING_VERSION=gemini-config-v1
# For another currency, set both generic rates (not the USD-named rates).
# GEMINI_INPUT_PRICE_PER_MILLION=...
# GEMINI_OUTPUT_PRICE_PER_MILLION=...
# Optionally set PRICING_EFFECTIVE_AT to a timezone-aware ISO timestamp; otherwise startup time is recorded.
MOCK_STREAM_DELAY_MS=18
